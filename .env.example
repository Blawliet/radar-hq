# Copie para .env e preencha:  cp .env.example .env

# ---------- Canal de envio ----------
#   telegram   bot do Telegram (padrão, roda no GitHub Actions sem PC)
#   evolution  WhatsApp self-hosted com Docker
#   baileys    WhatsApp self-hosted leve com Node
#   meta       API oficial do WhatsApp (bloqueada para o Brasil com número de teste)
CANAL=telegram

# Telegram (no GitHub, estes dois vão em Settings > Secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Evolution API
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
EVOLUTION_INSTANCE=radar

# Baileys (só se CANAL=baileys)
BAILEYS_URL=http://localhost:3333
BAILEYS_TOKEN=troque-este-token

# WhatsApp: seu número PESSOAL, que recebe os alertas (DDI + DDD + número, só dígitos)
WHATSAPP_DESTINO=5511999999999

# ---------- Banco da Evolution ----------
POSTGRES_PASSWORD=troque-esta-senha

# ---------- Coleta ----------
# Mercado Livre exige token desde 2025 (crie um app grátis em developers.mercadolivre.com.br)
ML_ACCESS_TOKEN=

# true = usa navegador real (Playwright) nas lojas que bloqueiam robôs (Amazon, Magalu)
USE_PLAYWRIGHT=true

# Pausa entre requisições na mesma loja, em segundos (seja educado com os sites)
DELAY_SEGUNDOS=4

# Webhook para escutar grupos de ofertas (opcional)
WEBHOOK_ENABLED=false
WEBHOOK_PALAVRAS=omnibus,saga do flash,spawn,one piece,blueberry,absolute batman,hickman
